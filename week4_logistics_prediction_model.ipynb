    {
      "cell_type": "code",
      "source": [
        "\n",
        "def calculate_metrics(actual, predicted):\n",
        "    return {\n",
        "        \"MAE_hours\": mean_absolute_error(actual, predicted),\n",
        "        \"RMSE_hours\": np.sqrt(\n",
        "            mean_squared_error(actual, predicted)\n",
        "        ),\n",
        "        \"R2\": r2_score(actual, predicted)\n",
        "    }\n",
        "\n",
        "predictions = {\n",
        "    \"Mean baseline\": pred_baseline,\n",
        "    \"Linear Regression\": pred_linear,\n",
        "    \"Tuned Decision Tree\": pred_tree\n",
        "}\n",
        "\n",
        "results = pd.DataFrame([\n",
        "    {\"Model\": name, **calculate_metrics(y_test, pred)}\n",
        "    for name, pred in predictions.items()\n",
        "])\n",
        "\n",
        "display(results.round(3))\n",
        "\n",
        "best_name = results.loc[\n",
        "    results[\"MAE_hours\"].idxmin(), \"Model\"\n",
        "]\n",
        "\n",
        "print(\"Model with lowest test MAE:\", best_name)\n"
      ],
