            "\n",
            "Column names:\n",
            "['Shipment_ID', 'Date', 'Route', 'Vehicle_Type', 'Shipment_Volume', 'Distance_km', 'Delivery_Time_hours', 'Transportation_Cost_INR', 'Fuel_Consumed_L', 'On_Time']\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "TARGET = \"Delivery_Time_hours\"\n",
        "\n",
        "NUMERIC = [\"Distance_km\", \"Shipment_Volume\"]\n",
        "CATEGORICAL = [\"Route\", \"Vehicle_Type\"]\n",
        "FEATURES = NUMERIC + CATEGORICAL\n",
        "\n",
        "required = FEATURES + [TARGET]\n",
        "missing = [col for col in required if col not in df.columns]\n",
        "\n",
        "if missing:\n",
        "    raise ValueError(f\"Missing required columns: {missing}\")\n",
        "\n",
        "model_data = df[required].dropna(subset=[TARGET]).copy()\n",
        "\n",
        "X = model_data[FEATURES]\n",
        "y = model_data[TARGET]\n",
        "\n",
        "print(\"Target variable:\", TARGET)\n",
        "print(\"Predictor variables:\", FEATURES)\n",
        "print(\"Total records:\", len(model_data))\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "KvDgEwlnOOMq",
        "outputId": "56d76eaa-e29f-41e3-a88a-0b2201d3509e"
      },
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Target variable: Delivery_Time_hours\n",
            "Predictor variables: ['Distance_km', 'Shipment_Volume', 'Route', 'Vehicle_Type']\n",
            "Total records: 90\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y, test_size=0.20, random_state=42\n",
        ")\n",
        "\n",
        "print(\"Training records:\", len(X_train))\n",
        "print(\"Testing records:\", len(X_test))\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "gqiTrxCUOSN-",
        "outputId": "ae6b5017-0657-4b5b-cc9b-c6831bf9d329"
      },
      "execution_count": 4,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Training records: 72\n",
            "Testing records: 18\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "numeric_pipeline = Pipeline([\n",
        "    (\"imputer\", SimpleImputer(strategy=\"median\"))\n",
        "])\n",
        "\n",
        "categorical_pipeline = Pipeline([\n",
        "    (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
        "    (\"encoder\", OneHotEncoder(handle_unknown=\"ignore\"))\n",
        "])\n",
        "\n",
        "preprocessor = ColumnTransformer([\n",
        "    (\"numeric\", numeric_pipeline, NUMERIC),\n",
        "    (\"categorical\", categorical_pipeline, CATEGORICAL)\n",
        "])\n",
        "\n",
        "cv = KFold(n_splits=5, shuffle=True, random_state=42)\n",
        "\n",
        "print(\"Preprocessing pipeline created successfully!\")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "alQ2BeBIOVaS",
        "outputId": "f49f39bc-9380-4be7-f490-e2c3d179d337"
      },
      "execution_count": 5,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Preprocessing pipeline created successfully!\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "baseline = DummyRegressor(strategy=\"mean\")\n",
        "\n",
        "baseline.fit(np.zeros((len(y_train), 1)), y_train)\n",
        "pred_baseline = baseline.predict(\n",
        "    np.zeros((len(y_test), 1))\n",
        ")\n",
        "\n",
        "linear = Pipeline([\n",
        "    (\"preprocessor\", preprocessor),\n",
        "    (\"model\", LinearRegression())\n",
        "])\n",
        "\n",
        "linear.fit(X_train, y_train)\n",
        "pred_linear = linear.predict(X_test)\n",
        "\n",
        "print(\"Baseline model trained successfully!\")\n",
        "print(\"Linear Regression model trained successfully!\")\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Ijvtt8erOY10",
        "outputId": "47205bbc-edee-4b5a-cd85-b0532b1b2a9b"
      },
      "execution_count": 6,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Baseline model trained successfully!\n",
            "Linear Regression model trained successfully!\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "tree = Pipeline([\n",
        "    (\"preprocessor\", preprocessor),\n",
        "    (\"model\", DecisionTreeRegressor(random_state=42))\n",
        "])\n",
        "\n",
        "param_grid = {\n",
        "    \"model__max_depth\": [2, 3, 4, 5, None],\n",
        "    \"model__min_samples_leaf\": [2, 3, 5, 8],\n",
        "    \"model__min_samples_split\": [2, 5, 10]\n",
        "}\n",
        "\n",
        "tree_search = GridSearchCV(\n",
        "    tree,\n",
        "    param_grid,\n",
        "    scoring=\"neg_mean_absolute_error\",\n",
        "    cv=cv,\n",
        "    n_jobs=-1\n",
        ")\n",
        "\n",
        "tree_search.fit(X_train, y_train)\n",
        "pred_tree = tree_search.predict(X_test)\n",
        "\n",
        "print(\"Best Decision Tree parameters:\")\n",
        "print(tree_search.best_params_)\n",
        "\n",
        "print(\"Tree tuning CV MAE (hours):\",\n",
        "      round(-tree_search.best_score_, 3))\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "A6lFdTr7OcK5",
        "outputId": "705eeae5-3035-4c91-ccf1-55e484e7535a"
      },
      "execution_count": 7,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Best Decision Tree parameters:\n",
            "{'model__max_depth': 3, 'model__min_samples_leaf': 2, 'model__min_samples_split': 2}\n",
